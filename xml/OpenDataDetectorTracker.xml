<lccdd>

        <include ref="detectors/BeamPipe.xml"/>
        <include ref="detectors/TrackerPixels.xml"/>
        <include ref="detectors/TrackerShortStrips.xml"/>
        <include ref="detectors/TrackerLongStrips.xml"/>
        <include ref="detectors/Solenoid.xml"/>

    <detectors>
        <detector id="1000" name="OpenDataTracker" type="DD4hep_SubdetectorAssembly" vis="invisible">
            <composite name="Pixels"/>
            <composite name="PST"/>
            <composite name="ShortStrips"/>
            <composite name="LongStrips"/>
        </detector>
    </detectors>

    <plugins>
        <plugin name="DD4hep_ParametersPlugin">
            <argument value="PST"/>
            <argument value="passive_layer: bool = true"/>
        </plugin>
        <plugin name="DD4hep_ParametersPlugin">
            <argument value="OpenDataTracker"/>
            <argument value="acts_legacy_assembly: bool = false"/>
        </plugin>
    </plugins>

</lccdd>
