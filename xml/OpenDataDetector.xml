<?xml version="1.0" encoding="UTF-8"?>
<lccdd xmlns:compact="http://www.lcsim.org/schemas/compact/1.0"
        xmlns:xs="http://www.w3.org/2001/XMLSchema" xs:noNamespaceSchemaLocation="http://www.lcsim.org/schemas/compact/1.0/compact.xsd">

        <info name="Open Data Detector" title="Open Data Detector" author="Andreas.Salzburger@cern.ch" url="" status="alpha" version="0">
                <comment>Demonstrator Detector for algorithmic research and development</comment>
        </info>
        
        <!-- Material definitions -->
        <includes>
                <gdmlFile ref="OpenDataDetectorElements.xml"/>
                <gdmlFile ref="OpenDataDetectorMaterials.xml"/>
        </includes>

        <!-- Global definitions -->
       <define>
                <!--World-->
                <constant name="world_size" value="12.*m"/>
                <constant name="world_x" value="world_size"/>
                <constant name="world_y" value="world_size"/>
                <constant name="world_z" value="world_size"/>

                <!-- BField -->
                <constant name="Field_nominal_value" value="3*tesla"/>
                <constant name="outerField_nominal_value" value="0.5*tesla"/>
        </define>
        
        <!-- Envelopes -->
        <include ref="OpenDataDetectorEnvelopes.xml"/>

        <!-- Identifier definitions -->
        <include ref="OpenDataDetectorIdentifiers.xml"/>

        <!-- Visualization definitions -->
        <include ref="OpenDataDetectorVisualization.xml"/>

        <!-- ACTS support -->
        <include ref="OpenDataDetectorActsSupport.xml"/>

        <!-- All Sub-detectors -->
        <include ref="OpenDataDetectorTracker.xml"/>
        <include ref="OpenDataDetectorCalorimeter.xml"/>
        <include ref="OpenDataDetectorMuonSystem.xml"/>

        <!-- Fields -->
        <include ref="OpenDataDetectorField.xml"/>

        <!-- Plugins -->
        <plugins>
                <plugin name="DD4hepVolumeManager"/>
                <plugin name="InstallSurfaceManager"/>
        </plugins>

</lccdd>
